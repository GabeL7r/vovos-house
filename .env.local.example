# Slack Incoming Webhook URL used to post new waitlist signups.
# Create one at https://api.slack.com/messaging/webhooks (add an Incoming Webhook
# to the workspace/channel where you want signups to land), then paste the URL here.
SLACK_WEBHOOK_URL=

# Google Analytics 4 Measurement ID. Find it in GA4 Admin -> Data Streams -> your
# web stream (format "G-XXXXXXXXXX"). Must be prefixed NEXT_PUBLIC_ so it's readable
# in the browser. Leave unset to disable GA locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
